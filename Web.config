<?xml version="1.0" encoding="utf-8"?>
<!--
  For more information on how to configure your ASP.NET application, please visit
  https://go.microsoft.com/fwlink/?LinkId=169433
  -->
<configuration>
	<!-- Accesso al Portale (Login.html): database SQL Express con gli utenti e il registro degli accessi.
		 Il collegamento usa l'account Windows del pool IIS (nessuna password qui dentro): i permessi li dà Login_01_database.sql.
		 Se SQL Server e' su un altro computer o ha un altro nome istanza, cambiare Data Source.
		 Per usare invece un utente SQL: Data Source=.\SQLEXPRESS;Initial Catalog=PortaleLogin;User ID=NOME;Password=PASSWORD
		 (nel Web.config & si scrive &amp; e " si scrive &quot;) -->
	<connectionStrings>
		<add name="PortaleLogin" providerName="System.Data.SqlClient" connectionString="Data Source=.\SQLEXPRESS;Initial Catalog=PortaleLogin;Integrated Security=True" />
	</connectionStrings>
	<appSettings>
		<!-- false = chi si registra deve essere attivato dall'amministratore (script Login_02_gestione_utenti.sql); true = entra subito -->
		<add key="RegistrazioneAutomatica" value="false" />
	</appSettings>
	<system.web>
		<compilation debug="true" strict="false" explicit="true" targetFramework="4.7.2" />
		<httpRuntime targetFramework="4.7.2" />

		<!-- Tutto il sito richiede il login: chi non e' entrato viene mandato a Login.html.
			 La sessione dura 10 ore (si rinnova mentre si usa il sito). Se il Portale e' su HTTPS mettere requireSSL="true". -->
		<authentication mode="Forms">
			<forms name=".PortaleServizi" loginUrl="~/Login.html" defaultUrl="~/Portale.html" timeout="600" slidingExpiration="true" protection="All" requireSSL="false" cookieless="UseCookies" />
		</authentication>
		<authorization>
			<deny users="?" />
		</authorization>
		<httpCookies httpOnlyCookies="true" />
	</system.web>

	<!-- Pubblico, senza login: solo la pagina di accesso e quello che le serve (gestore API, stile, script, logo) -->
	<location path="Login.html">
		<system.web>
			<authorization>
				<allow users="*" />
			</authorization>
		</system.web>
	</location>
	<location path="API/Auth.ashx">
		<system.web>
			<authorization>
				<allow users="*" />
			</authorization>
		</system.web>
	</location>
	<location path="CSS/Login">
		<system.web>
			<authorization>
				<allow users="*" />
			</authorization>
		</system.web>
	</location>
	<location path="JS/Login">
		<system.web>
			<authorization>
				<allow users="*" />
			</authorization>
		</system.web>
	</location>
	<location path="IMG">
		<system.web>
			<authorization>
				<allow users="*" />
			</authorization>
		</system.web>
	</location>

	<system.codedom>
		<compilers>
			<compiler language="c#;cs;csharp" extension=".cs" type="Microsoft.CodeDom.Providers.DotNetCompilerPlatform.CSharpCodeProvider, Microsoft.CodeDom.Providers.DotNetCompilerPlatform, Version=2.0.1.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" warningLevel="4" compilerOptions="/langversion:default /nowarn:1659;1699;1701" />
			<compiler language="vb;vbs;visualbasic;vbscript" extension=".vb" type="Microsoft.CodeDom.Providers.DotNetCompilerPlatform.VBCodeProvider, Microsoft.CodeDom.Providers.DotNetCompilerPlatform, Version=2.0.1.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" warningLevel="4" compilerOptions="/langversion:default /nowarn:41008 /define:_MYTYPE=\&quot;Web\&quot; /optionInfer+" />
		</compilers>
	</system.codedom>

	<!-- Questo determina quale delle pagine si apre come predefinita
		 NB L'ordine determina la priorità in caso di fallimento nel caricare una pagina-->
	<system.webServer>
		<!-- Senza questa riga il login proteggerebbe solo i file .ashx/.aspx e non le pagine .html, i file Excel, i CSS e gli script -->
		<modules runAllManagedModulesForAllRequests="true" />
		<defaultDocument enabled="true">
			<files>
				<clear />
				<add value="Portale.html" />
				<add value="Certificati.html" />
			</files>
		</defaultDocument>
	</system.webServer>
</configuration>